{"@context":"https://schema.org","@type":"FAQPage","@id":"https://resplandor.ynt.codes/#preguntas","url":"https://resplandor.ynt.codes/#preguntas","inLanguage":"es","isPartOf":{"@id":"https://resplandor.ynt.codes/#sitio"},"mainEntity":[{"@type":"Question","name":"¿Las celebraciones se pueden hacer fuera del restaurante?","acceptedAnswer":{"@type":"Answer","text":"No. Todo evento y toda celebración se organiza en el local, de 10 a 30 personas."}},{"@type":"Question","name":"¿Cuál es la capacidad del local?","acceptedAnswer":{"@type":"Answer","text":"Hasta 30 personas. Es el mismo local donde comes a diario: no tenemos un salón aparte para eventos."}},{"@type":"Question","name":"¿Con cuánta anticipación aviso?","acceptedAnswer":{"@type":"Answer","text":"Para una celebración recomendamos avisar con al menos 48 horas. Si solo quieres una mesa, sin celebración, escríbenos por WhatsApp el mismo día."}},{"@type":"Question","name":"¿Cómo se confirma y se paga?","acceptedAnswer":{"@type":"Answer","text":"Todo se conversa y confirma directamente por WhatsApp con el restaurante — sin pagos en línea ni anticipos automáticos por este sitio."}}]}
